# ===== Bot Barons — переменные окружения =====
# Локально: скопируй в .env (файл в .gitignore). На Railway: Variables сервиса.

# PostgreSQL (Railway выдаёт DATABASE_URL автоматически)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Главный бот
MAIN_BOT_TOKEN=123456:ABC...

# Админ-бот
ADMIN_BOT_TOKEN=123456:XYZ...
# Telegram ID администраторов через запятую
ADMIN_ID=227653457
# Публичный канал игроков и приватный канал "Тайная комната"
USERS_CHANNEL_ID=-1001234567890
ADMIN_SECRET_CHANNEL_ID=-1009876543210
# Юзернейм главного бота для deep-link (без @)
MAIN_BOT_USERNAME=BotBaronsBot

# Тест-режим магазина: 1 = перечисленные ID получают товары без оплаты.
# НА ПРОДЕ ДОЛЖНО БЫТЬ 0 (или переменная удалена).
SHOP_TEST_MODE=0
SHOP_TEST_USER_IDS=227653457

# Тестовая БД для pytest (отдельная база!)
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/roflhub_test
